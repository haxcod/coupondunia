# =============================================================================
# DealSpark / Coupon Saga — environment variables
# =============================================================================
# Copy this file to `.env.local` and fill in real values:
#     cp .env.example .env.local
# `.env.local` is gitignored. Nothing here is read at build time except where
# noted — the app is designed to build without a database (static shell + PPR).
# -----------------------------------------------------------------------------


# --- Core: database + session signing (REQUIRED to run) ----------------------

# MongoDB connection string. Any MongoDB 6+ works. Transactions are used by the
# click service, so a replica set is required (MongoDB Atlas provides one by
# default; a standalone local server does NOT — use Atlas or `mongod --replSet`).
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/dealspark

# Secret used to sign the admin session cookie (jose HS256). Use a long random
# value, e.g.  `openssl rand -base64 48`. AUTH_SECRET is accepted as a fallback.
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars


# --- Admin bootstrap (used only by `npm run seed`) ---------------------------

# The initial administrator account created by the seed script. Log in at
# /admin/login with these. Change the password after first login.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password


# --- Site (REQUIRED in production) -------------------------------------------

# Absolute public origin, no trailing slash. Used for canonical URLs, Open
# Graph/Twitter image resolution (metadataBase), sitemap, and robots.
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com


# --- Email / contact form (OPTIONAL) -----------------------------------------
# Without these the contact form still SAVES messages (visible in the admin);
# it just skips the notification email. Provide all six to enable notifications.

SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
# `true` for implicit TLS (port 465), `false` for STARTTLS (port 587).
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
# The From address shown on notification emails.
SMTP_FROM="Coupon Saga <no-reply@your-domain.com>"
# Where contact-form notifications are sent. Falls back to the admin
# `contactEmail` setting, then ADMIN_EMAIL, when unset.
CONTACT_NOTIFICATION_EMAIL=alerts@your-domain.com


# --- Image uploads / object storage (OPTIONAL) -------------------------------
# Enables the admin image upload at /api/admin/upload. Works with AWS S3 or any
# S3-compatible provider (Cloudflare R2, DigitalOcean Spaces, MinIO, Backblaze).
# Without these the app still runs; admins just can't upload images (existing
# image URLs keep working — next/image already allows any https host).

S3_BUCKET=your-bucket-name
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
# Region (defaults to us-east-1 when omitted).
S3_REGION=us-east-1
# Custom endpoint for S3-compatible providers (leave blank for AWS S3).
# e.g. R2: https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT=
# Public/CDN base URL that serves the bucket objects (recommended). When set,
# uploaded image URLs are built from it. e.g. https://cdn.your-domain.com
S3_PUBLIC_BASE_URL=
# Most S3-compatible providers need path-style addressing; set `true` for them.
# Auto-enabled when S3_ENDPOINT is set.
S3_FORCE_PATH_STYLE=false
